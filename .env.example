# Copy to .env (git-ignored) and fill in. Leave a value empty to disable that provider.
OPENROUTER_API_KEY=
# Model slug for the single web-enabled call (default is set in llm.py). Model names change; check openrouter.ai/models.
OPENROUTER_MODEL=
# openrouter (default) | fake
LLM_PROVIDER=
PAXA_API_KEY=
JEV_MIN_CONF=
# Text-to-speech (same PAXA_API_KEY). Empty = defaults: lukchup, paxa-tts-flash-v1, 12 upstream calls per minute.
PAXA_TTS_VOICE=
PAXA_TTS_MODEL=
TTS_MAX_CALLS_PER_MIN=
