# Copy to .env (git-ignored) and fill in. Leave a value empty to disable that provider.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# gemini (default) | openrouter | fake
LLM_PROVIDER=
PAXA_API_KEY=
JEV_MIN_CONF=
# Note: model names change. gemini-2.5-flash is closed to new accounts; leave GEMINI_MODEL empty for the default
# (gemini-flash-latest). Gemini search grounding may be unavailable on the free tier; research then falls back to
# OpenRouter (if keyed) and finally to ungrounded Gemini, which the UI reports as "no live web data".
